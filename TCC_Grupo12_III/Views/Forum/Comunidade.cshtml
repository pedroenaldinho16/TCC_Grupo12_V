@model TCC_Grupo12_III.Models.ForumComunidade
@using TCC_Grupo12_III.Data

@{
    ViewData["Title"] = $"{Model.Nome} - Comunidade";
    var topicos = (List<TCC_Grupo12_III.Models.ForumTopico>)ViewBag.Topicos;
    var campanhas = (List<TCC_Grupo12_III.Models.Campanha>)ViewBag.CampanhasDestaque;
    var curtidos = (HashSet<int>)ViewBag.TopicosCurtidos;
    var busca = (string?)ViewBag.Busca;
    var ordem = (string?)ViewBag.Ordem ?? "recentes";
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var isModerador = (bool)(ViewBag.IsModerador ?? false);
    var usuarioSuspenso = (bool)(ViewBag.UsuarioSuspenso ?? false);
    var podeCriarTopicoNivel = (bool)(ViewBag.PodeCriarTopicoNivel ?? false);
}

<div class="eco-page">
    <!-- Voltar para Fórum -->
    <a class="eco-back-link mb-3" asp-controller="Forum" asp-action="Index" asp-route-aba="comunidades">
        <i class="bi bi-arrow-left me-1"></i> Ver Todas as Comunidades
    </a>

    <!-- Header Hero da Comunidade -->
    <div class="card border rounded-4 bg-white shadow-sm overflow-hidden mb-4">
        @if (!string.IsNullOrWhiteSpace(Model.BannerPath))
        {
            <div style="height: 180px; width: 100%; background: url('@Model.BannerPath') center/cover no-repeat; position: relative;">
                <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.6) 100%);"></div>
            </div>
        }
        else
        {
            <div style="height: 140px; width: 100%; background: linear-gradient(135deg, #064E3B 0%, #0E7C66 50%, #10B981 100%); position: relative;">
                <div style="position: absolute; inset: 0; background: radial-gradient(circle at 80% 20%, rgba(255,255,255,0.15) 0%, transparent 60%);"></div>
            </div>
        }

        <div class="card-body p-4 position-relative">
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle border border-3 border-white shadow-sm d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0" 
                         style="width: 72px; height: 72px; margin-top: -46px; background: #ffffff; z-index: 2;">
                        @if (!string.IsNullOrWhiteSpace(Model.IconePath))
                        {
                            <img src="@Model.IconePath" alt="@Model.Nome" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else if (Model.IsGeral)
                        {
                            <span style="font-size: 2.2rem;">🏛️</span>
                        }
                        else
                        {
                            <span style="font-size: 2.2rem;">🌿</span>
                        }
                    </div>

                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h1 class="h3 fw-bold text-dark mb-0" style="font-family: 'Sora', sans-serif;">@Model.Nome</h1>
                            @if (Model.IsGeral)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                    <i class="bi bi-shield-check me-1"></i> Comunidade Geral Oficial
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">
                                    <i class="bi bi-person-badge me-1 text-success"></i> Fundada por @(Model.Criador?.Nome ?? "Membro Credenciado")
                                </span>
                            }
                        </div>
                        <p class="text-muted mt-2 mb-0" style="max-width: 720px; font-size: 0.95rem; line-height: 1.5;">@Model.Descricao</p>
                    </div>
                </div>

                <!-- Botão de Novo Tópico -->
                <div class="d-flex align-items-center gap-2">
                    @if (usuarioSuspenso)
                    {
                        <span class="btn-eco btn-eco--ghost text-muted border-warning" title="Você está suspenso de postar">
                            <i class="bi bi-lock-fill text-warning me-1"></i> Publicação Bloqueada
                        </span>
                    }
                    else if (!podeCriarTopicoNivel)
                    {
                        <a class="btn-eco btn-eco--ghost" asp-controller="Nivel" asp-action="Index" title="Requer Nível 2">
                            <i class="bi bi-lock-fill text-warning me-1"></i> Postar (Requer Nível 2)
                        </a>
                    }
                    else
                    {
                        <a class="btn-eco btn-eco--solid shadow-sm" asp-controller="Forum" asp-action="Criar" asp-route-comunidadeId="@Model.Id" asp-route-categoria="comunidade">
                            <i class="bi bi-pencil-square me-2"></i> Novo Post nesta Comunidade
                        </a>
                    }
                </div>
            </div>

            <!-- Regras da Comunidade se existirem -->
            @if (!string.IsNullOrWhiteSpace(Model.Regras))
            {
                <div class="mt-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-info-circle-fill text-success"></i>
                        <strong class="text-dark small">Regras & Diretrizes Desta Comunidade:</strong>
                    </div>
                    <p class="mb-0 small text-muted" style="white-space: pre-line;">@Model.Regras</p>
                </div>
            }

            <!-- Estatísticas Rápidas -->
            <div class="d-flex align-items-center gap-4 mt-3 pt-3 border-top flex-wrap text-muted small">
                <div><i class="bi bi-chat-left-text text-success me-1"></i> <strong>@topicos.Count</strong> posts</div>
                <div><i class="bi bi-reply-all text-success me-1"></i> <strong>@topicos.Sum(t => t.Respostas.Count)</strong> comentários</div>
                <div><i class="bi bi-heart text-danger me-1"></i> <strong>@topicos.Sum(t => t.Curtidas.Count)</strong> curtidas</div>
                <div><i class="bi bi-megaphone text-primary me-1"></i> <strong>@campanhas.Count</strong> campanhas ativas</div>
            </div>
        </div>
    </div>

    <!-- SEÇÃO DE DESTAQUE: Campanhas Vinculadas à Comunidade -->
    @if (campanhas.Count > 0)
    {
        <div class="mb-5">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div>
                    <h3 class="h4 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-megaphone-fill text-success"></i> Campanhas da Comunidade em Ação
                    </h3>
                    <p class="text-muted small mb-0">Iniciativas ecológicas de campo conectadas aos membros desta comunidade.</p>
                </div>
                <a class="btn btn-sm btn-outline-success rounded-pill px-3" asp-controller="Campanhas" asp-action="Index">
                    Ver todas as campanhas <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-3">
                @foreach (var camp in campanhas)
                {
                    var pct = camp.Meta > 0 ? Math.Min(100, (int)(camp.Participantes * 100.0 / camp.Meta)) : 0;
                    var ehFutura = camp.DataInicio.HasValue && camp.DataInicio.Value.Date > DateTime.Today;

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border rounded-4 bg-white shadow-sm overflow-hidden position-relative hover-shadow transition">
                            <div class="position-relative" style="height: 140px; background: #e2e8f0;">
                                @if (!string.IsNullOrWhiteSpace(camp.ImagemUrl))
                                {
                                    <img src="@camp.ImagemUrl" alt="@camp.Titulo" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100" style="background: linear-gradient(135deg, #064E3B 0%, #10B981 100%); color:#fff;">
                                        <i class="bi bi-tree-fill fs-1"></i>
                                    </div>
                                }
                                <div class="position-absolute top-0 start-0 m-2">
                                    @if (ehFutura)
                                    {
                                        <span class="badge bg-primary text-white shadow-sm">Próxima Ação</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white shadow-sm">Em Andamento</span>
                                    }
                                </div>
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <h5 class="fw-bold text-dark mb-1" style="font-size: 1rem;">@camp.Titulo</h5>
                                <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @camp.Descricao
                                </p>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between text-muted small mb-1">
                                        <span>Voluntários</span>
                                        <strong>@camp.Participantes / @camp.Meta</strong>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-success" style="width: @pct%;"></div>
                                    </div>
                                </div>

                                <a asp-controller="Campanhas" asp-action="Detalhes" asp-route-id="@camp.Id" class="btn btn-sm btn-outline-success w-100 rounded-pill fw-semibold">
                                    @(ehFutura ? "Pré-inscrever-se" : "Participar da Ação")
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- SEÇÃO: Discussões e Tópicos da Comunidade -->
    <div>
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <h3 class="h4 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-chat-square-dots-fill text-success"></i> Discussões da Comunidade
                </h3>
                <span class="text-muted small">@topicos.Count post(s) encontrado(s)</span>
            </div>

            <!-- Busca e Filtros -->
            <form asp-controller="Forum" asp-action="Comunidade" asp-route-slug="@Model.Slug" method="get" class="d-flex gap-2">
                <input type="text" name="busca" value="@busca" placeholder="Buscar nesta comunidade..." class="form-control form-control-sm" style="max-width: 240px;" />
                <select name="ordem" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                    <option value="recentes" selected="@(ordem == "recentes")">Mais Recentes</option>
                    <option value="populares" selected="@(ordem == "populares")">Mais Curtidos</option>
                    <option value="respostas" selected="@(ordem == "respostas")">Mais Comentados</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
            </form>
        </div>

        @if (topicos.Count == 0)
        {
            <div class="card border rounded-4 bg-white p-5 text-center shadow-sm">
                <div class="mb-3">
                    <span class="p-3 rounded-circle bg-light d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                        <i class="bi bi-chat-square-text text-muted fs-3"></i>
                    </span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Nenhuma discussão iniciada nesta comunidade ainda</h5>
                <p class="text-muted small mb-3">Seja o primeiro a compartilhar um relato, dúvida ou observação científica com outros membros!</p>
                <div>
                    @if (podeCriarTopicoNivel && !usuarioSuspenso)
                    {
                        <a class="btn-eco btn-eco--solid btn-eco--sm shadow-sm" asp-controller="Forum" asp-action="Criar" asp-route-comunidadeId="@Model.Id" asp-route-categoria="comunidade">
                            <i class="bi bi-pencil-square me-1"></i> Criar o Primeiro Post
                        </a>
                    }
                    else if (!podeCriarTopicoNivel)
                    {
                        <a class="btn-eco btn-eco--ghost btn-eco--sm" asp-controller="Nivel" asp-action="Index">
                            <i class="bi bi-lock-fill text-warning me-1"></i> Desbloquear no Nível 2
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="eco-forum-list">
                @foreach (var t in topicos)
                {
                    var curtiu = curtidos.Contains(t.Id);
                    <article class="eco-forum-card">
                        <div class="eco-forum-card__votes">
                            <form asp-controller="Forum" asp-action="CurtirTopico" asp-route-id="@t.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="eco-forum-vote-btn @(curtiu ? "is-liked" : "")" title="@(curtiu ? "Descurtir" : "Curtir")">
                                    <i class="bi bi-caret-up-fill"></i>
                                    <span>@t.Curtidas.Count</span>
                                </button>
                            </form>
                        </div>

                        <div class="eco-forum-card__content">
                            <div class="eco-forum-card__header">
                                <a class="eco-forum-card__title" asp-controller="Forum" asp-action="Detalhe" asp-route-id="@t.Id">
                                    @t.Titulo
                                </a>
                            </div>

                            <p class="eco-forum-card__snippet">
                                @(t.Conteudo.Length > 200 ? t.Conteudo.Substring(0, 200) + "..." : t.Conteudo)
                            </p>

                            <div class="eco-forum-card__footer">
                                <div class="eco-forum-card__author">
                                    <span class="eco-avatar-sm">@(t.Usuario?.Nome?.Length > 0 ? t.Usuario.Nome.Substring(0, 1).ToUpper() : "U")</span>
                                    <span>@(t.Usuario?.Nome ?? "Anônimo")</span>
                                    <span class="eco-bullet">&bull;</span>
                                    <time>@t.CriadoEm.ToString("dd/MM/yyyy HH:mm")</time>
                                </div>

                                <div class="eco-forum-card__stats">
                                    <span><i class="bi bi-chat-text"></i> @t.Respostas.Count</span>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
