@model List<TCC_Grupo12_III.Models.ForumTopico>
@{ViewData["Title"]="Revisar mural das campanhas";}
<div class="ec-page"><h1>Mural das campanhas</h1><partial name="_AdminTabs" />@if(Model.Count==0){<p class="ec-empty">Nenhuma publicação nos murais das campanhas.</p>}@foreach(var t in Model){<article class="ec-card mb-4"><h2 style="font-size:1.3rem">@t.Titulo</h2><p>@t.Usuario?.Nome · @(t.Categoria.StartsWith("arquivada:")?"Arquivada":"Publicada")</p><p>@t.Conteudo</p><form asp-action="Arquivar" method="post"><input name="id" value="@t.Id" type="hidden" /><button class="ec-button ec-button-outline" type="submit">@(t.Categoria.StartsWith("arquivada:")?"Restaurar publicação":"Arquivar publicação")</button></form>@foreach(var r in t.Respostas){<p>@r.Conteudo</p><form asp-action="OcultarResposta" method="post"><input name="id" value="@r.Id" type="hidden" /><button class="ec-button ec-button-outline" type="submit">Retirar comentário</button></form>}</article>}</div>