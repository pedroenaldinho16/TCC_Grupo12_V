@model TCC_Grupo12_III.Models.EspecieQuizResultadoViewModel
<section class="ec-card"><h2>O que você descobriu?</h2><p class="ec-stat">@Model.Percentual%</p><p>@Model.Acertos de @Model.Total respostas corretas.</p><p>@(Model.QuizAprovado?"Quiz concluído com aproveitamento mínimo.":"Revise a ficha e tente novamente para alcançar pelo menos 70%.")</p>@if(!string.IsNullOrEmpty(Model.XpMensagem)){<p>@Model.XpMensagem</p>}@if(Model.Dominada){<p class="ec-notice">Ficha estudada e quiz concluído: espécie conquistada na CantaDex.</p>}else{<p>Para conquistar esta espécie na CantaDex, estude a ficha, marque a leitura e conclua o quiz.</p>}<p>O mapa é liberado pela jornada dos três desafios.</p></section>
<section class="ec-section"><h2>Aprenda com suas respostas</h2>@foreach(var item in Model.Itens){var q=item.Pergunta;var tema=q.Enunciado.ToLowerInvariant();var explicacao=tema.Contains("alimenta")?Model.Especie.Alimentacao:tema.Contains("habitat")?Model.Especie.Habitat:tema.Contains("amea")?Model.Especie.Ameacas:Model.Especie.Caracteristicas+" "+Model.Especie.Comportamento;<article class="ec-card mb-3"><h3>@q.Enunciado</h3><p>Sua escolha: @(item.Selecionada.HasValue?q.OpcaoTexto(item.Selecionada.Value):"Sem resposta")</p><p><strong>Resposta esperada: @q.OpcaoTexto(q.RespostaCorreta)</strong></p><p class="ec-article">@explicacao</p><small>Conteúdo da ficha educativa do Grupo 12; referências científicas específicas em revisão.</small></article>}</section>