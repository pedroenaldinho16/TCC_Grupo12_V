@using TCC_Grupo12_III.Services
@inject JornadaService Jornada
@{
 var logado = User.Identity?.IsAuthenticated == true;
 var atual = ViewContext.RouteData.Values["controller"]?.ToString();
 var acao = ViewContext.RouteData.Values["action"]?.ToString();
 var mapaAberto = atual == "Avistamentos" || (atual == "Jornada" && acao == "Mapa");
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
 <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <meta name="description" content="Conheça a fauna da Serra da Cantareira e aprenda a preservá-la. Uma jornada educativa para estudantes do ensino médio." />
 <title>@ViewData["Title"] · EcoCanta</title>
 <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
 <meta name="theme-color" content="#f1faf7" />
 <script src="~/js/theme.js" asp-append-version="true"></script>
 <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
 <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
 <link rel="stylesheet" href="~/css/eco-theme.css" asp-append-version="true" />
 <link rel="stylesheet" href="~/css/meta2.css" asp-append-version="true" />
 <link rel="stylesheet" href="~/css/appearance.css" asp-append-version="true" />
 @if(atual == "Jornada"){<link rel="stylesheet" href="~/css/jornada-jogos.css" asp-append-version="true" />}
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
 <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
 <header class="ec-header">
  <div class="ec-container ec-header-inner">
   <a class="ec-brand" asp-controller="Home" asp-action="Index"><img src="~/img/marca/logo-original.png" alt="" width="42" height="42" /><span>EcoCanta</span></a>
   <div class="ec-header-controls">
    <button class="ec-theme-toggle" type="button" data-theme-toggle hidden aria-label="Modo escuro" aria-pressed="false">
     <svg class="ec-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
     <svg class="ec-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 15.7A8.5 8.5 0 0 1 8.3 4 8.5 8.5 0 1 0 20 15.7Z"/></svg>
     <span data-theme-label>Claro</span>
    </button>
    <button class="ec-menu" type="button" aria-expanded="false" aria-controls="navegacao">Menu <span aria-hidden="true">☰</span></button>
   </div>
   <nav id="navegacao" class="ec-nav" aria-label="Navegação principal">
    <a class="@(atual == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Início</a>
    <a class="@(atual == "Especies" ? "active" : "")" asp-controller="Especies" asp-action="Index">Conheça os animais</a>
    <a class="@(atual == "Jornada" && !mapaAberto ? "active" : "")" asp-controller="Jornada" asp-action="Index">Jogos e desafios</a>
    <a class="ec-nav-map @(mapaAberto ? "active" : "")" asp-controller="Jornada" asp-action="Mapa">Mapa</a>
    <a class="@(atual == "Campanhas" ? "active" : "")" asp-controller="Campanhas" asp-action="Index">Campanhas</a>
    <a asp-controller="Home" asp-action="Sobre">Sobre o projeto</a>
    <div class="ec-nav-auth">
    @if (logado) {
     <a asp-controller="Jornada" asp-action="Progresso">Meu progresso</a>
     @if (User.IsInRole("Admin")) { <a asp-controller="Admin" asp-action="Index">Administração</a> }
     <form asp-controller="Login" asp-action="Logout" method="post"><button class="ec-button ec-button-outline" type="submit">Sair</button></form>
    } else {
     <a class="ec-button ec-button-outline" asp-controller="Login" asp-action="Index">Entrar</a>
     <a class="ec-button" asp-controller="Cadastro" asp-action="Index">Cadastrar</a>
    }
    </div>
   </nav>
  </div>
 </header>
 @if (logado) {
 <nav class="ec-subnav ec-container" aria-label="Área do estudante">
  <a asp-controller="Jornada" asp-action="Index">Minha jornada</a><a asp-controller="Jornada" asp-action="Progresso">Minhas conquistas</a><a asp-controller="Educacao" asp-action="Index">Voz Estudantil</a><a asp-controller="Perfil" asp-action="Index">Minha conta</a><a asp-controller="Faq" asp-action="Index">Ajuda</a>
 </nav>
 }
 <main id="conteudo" tabindex="-1">
  <div class="ec-container">
  @foreach (var chave in new[] { "Sucesso", "Erro", "Aviso", "Info", "Xp" }) {
   @if (TempData[chave] is string mensagem) { <div class="ec-notice @(chave == "Erro" ? "ec-notice-error" : "")" role="@(chave == "Erro" ? "alert" : "status")">@mensagem</div> }
  }
  </div>
  @RenderBody()
 </main>
 <footer class="ec-footer">
  <div class="ec-container ec-footer-grid">
   <div><a class="ec-brand" asp-controller="Home" asp-action="Index"><img src="~/img/marca/logo-original.png" alt="" width="40" height="40" />EcoCanta</a><p>Conhecer para preservar.<br />Educação ambiental sobre a fauna da Serra da Cantareira.</p></div>
   <div><strong>Explore</strong><a asp-controller="Especies" asp-action="Index">Conheça os animais</a><a asp-controller="Jornada" asp-action="Index">Jogos e desafios</a><a asp-controller="Jornada" asp-action="Mapa">Mapa de avistamentos</a><a asp-controller="Educacao" asp-action="Index">Voz Estudantil</a></div>
   <div><strong>Projeto</strong><a asp-controller="Campanhas" asp-action="Index">Campanhas</a><a asp-controller="Home" asp-action="Sobre">Sobre a EcoCanta</a><a asp-controller="Faq" asp-action="Index">Ajuda e orientações</a></div>
  </div>
  <div class="ec-container ec-footer-bottom">© 2026 EcoCanta · Grupo 12 · ETEC de Campo Limpo Paulista</div>
 </footer>
 <script src="~/lib/jquery/dist/jquery.min.js"></script>
 <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
 <script src="~/js/meta2.js" asp-append-version="true"></script>
 @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
