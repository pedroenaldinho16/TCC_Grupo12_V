@model TCC_Grupo12_III.Controllers.FaqIndexViewModel
@{ViewData["Title"]="Ajuda e orientações";}
<div class="ec-page" style="max-width:900px"><span class="ec-eyebrow">Um apoio para sua jornada</span><h1>Como podemos ajudar?</h1><section class="ec-section"><details class="ec-card mb-3"><summary>Por onde começar?</summary><p>Explore o catálogo e as fichas. Depois, siga para Jogos e desafios e comece pelo Detetive da Fauna.</p></details><details class="ec-card mb-3"><summary>Como desbloquear o mapa?</summary><p>Complete as associações do Detetive, alcance pelo menos 70% no quiz do Guardião e cumpra todas as missões no cenário. Você pode revisar os conteúdos e tentar novamente.</p></details><details class="ec-card mb-3"><summary>Como publicar na Voz Estudantil?</summary><p>Entre na sua conta, escreva sobre seu aprendizado e informe as fontes. A administração revisará o texto antes da publicação.</p></details><details class="ec-card"><summary>Como participar dos murais?</summary><p>Abra uma campanha e compartilhe reflexões relacionadas à preservação. Respeite os colegas e não divulgue coordenadas de ninhos ou abrigos.</p></details></section>
@if(Model.UsuarioAutenticado){<h2>Minhas dúvidas</h2>@foreach(var t in Model.MeusTickets){<p><a asp-action="Conversa" asp-route-id="@t.Id">@t.Assunto · @t.Status</a></p>}<form method="post" asp-action="NovaPergunta" class="ec-card mt-4"><h2 style="font-size:1.3rem">Falar com a equipe</h2><input name="categoria" value="Geral" type="hidden" /><div class="ec-field"><label for="assunto">Assunto</label><input id="assunto" name="assunto" required maxlength="150" /></div><div class="ec-field"><label for="mensagem">Sua dúvida</label><textarea id="mensagem" name="mensagem" required maxlength="2000" rows="4"></textarea></div><button class="ec-button" type="submit">Enviar dúvida</button></form>}else{<a class="ec-button" asp-controller="Login" asp-action="Index">Entrar para falar com a equipe</a>}</div>