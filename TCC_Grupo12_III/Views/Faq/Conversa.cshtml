@model TCC_Grupo12_III.Models.FaqTicket
@{ViewData["Title"]="Atendimento";}
<div class="ec-page" style="max-width:850px"><a class="ec-breadcrumb" asp-action="Index">← Ajuda e orientações</a><h1>@Model.Assunto</h1><p>Situação: @Model.Status</p>@foreach(var m in Model.Mensagens.OrderBy(m=>m.CriadoEm)){<article class="ec-card mb-3"><strong>@m.Usuario?.Nome · @(m.IsEquipeModOuAdmin?"Administração":"Estudante")</strong><p class="ec-article">@m.Conteudo</p><small>@m.CriadoEm.ToString("dd/MM/yyyy HH:mm")</small></article>}@if(Model.Status!="Fechado"){<form asp-action="EnviarMensagem" method="post" class="ec-card"><input name="ticketId" value="@Model.Id" type="hidden" /><div class="ec-field"><label for="conteudo">Mensagem para a equipe</label><textarea id="conteudo" name="conteudo" required maxlength="2000" rows="4"></textarea></div><button class="ec-button" type="submit">Enviar mensagem</button></form>}</div>