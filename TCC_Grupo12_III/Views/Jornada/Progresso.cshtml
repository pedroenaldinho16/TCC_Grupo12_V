@model List<JornadaTentativa>
@using TCC_Grupo12_III.Services
@{
    ViewData["Title"] = "Progresso e conquistas";
    var feitos = Model.Where(t => t.Aprovada).Select(t => t.Desafio).Distinct().ToHashSet();
    var acesso = new AcessoMapaViewModel(true, User.IsInRole("Admin"), feitos.Count);
}
<div class="ec-page">
    <span class="ec-eyebrow">Seu aprendizado fica com você</span>
    <h1>Progresso e conquistas</h1>
    <p class="ec-lead">Cada desafio concluído traz uma recompensa. Elas ficam salvas com seu progresso e continuam disponíveis quando você volta.</p>
    <div class="ec-grid ec-progress-stats">
        <div class="ec-card"><div class="ec-stat">@feitos.Count / 3</div><p>Desafios concluídos</p></div>
        <div class="ec-card"><div class="ec-stat">@Model.Count</div><p>Tentativas iniciadas</p></div>
        <div class="ec-card"><div class="ec-stat">@(acesso.Liberado ? "Liberado" : "Bloqueado")</div><p>Mapa de avistamentos</p></div>
    </div>
    <section class="ec-guardian-summary" aria-labelledby="seu-guardiao">
        <partial name="_GuardiaoAvatar" model="new GuardiaoAvatarViewModel(feitos.Contains(1), feitos.Contains(2))" />
        <div>
            <span class="ec-eyebrow">Sua identidade na jornada</span>
            <h2 id="seu-guardiao">Seu guardião</h2>
            <p>@(feitos.Contains(1) ? "Avatar de Guardião conquistado! Ele representa o que você aprendeu sobre a fauna." : "Conclua o Detetive da Fauna para conquistar seu avatar de Guardião.")</p>
            <p>@(feitos.Contains(2) ? "Acessório de guardião conquistado: seu avatar já está usando o escudo." : "No segundo desafio, você conquista um escudo para acompanhar seu avatar.")</p>
        </div>
    </section>
    <section class="ec-rewards-section" aria-labelledby="minhas-recompensas">
        <div class="ec-section-head"><div><h2 id="minhas-recompensas">Minhas recompensas</h2><p>Complete as associações, alcance 70% no quiz e cumpra as missões para conquistar cada item.</p></div></div>
        <div class="ec-grid">
            @for (var i = 1; i <= 3; i++)
            {
                var conquistada = feitos.Contains(i);
                var descricoes = new[] { "Um avatar de Guardião da Cantareira.", "Um escudo que acompanha seu avatar.", "Acesso ao mapa e aos avistamentos aprovados." };
                <article class="ec-card ec-reward-card @(conquistada ? "is-earned" : "")" data-reward-stage="@i" data-earned="@conquistada.ToString().ToLowerInvariant()">
                    <span class="ec-pill">@(conquistada ? "✓ Conquistada" : "A conquistar")</span>
                    <h3>@JornadaService.Recompensas[i - 1]</h3>
                    <p>@descricoes[i - 1]</p>
                    <small>@JornadaService.Titulos[i - 1]</small>
                    @if (i == 3 && acesso.Liberado)
                    {
                        <a class="mt-3" asp-action="Mapa">@(acesso.Administrador ? "Abrir mapa como administrador" : "Abrir meu mapa") →</a>
                    }
                </article>
            }
        </div>
    </section>
    <partial name="_AcessoMapa" model="acesso" />
    <section class="ec-section">
        <h2>Seu histórico de aprendizagem</h2>
        @if (Model.Count == 0)
        {
            <p class="ec-empty">Sua primeira descoberta está esperando. Comece pelo Detetive da Fauna.</p>
        }
        else
        {
            <div class="ec-history"><table>
                <caption>Todas as tentativas, incluindo desafios em andamento.</caption>
                <thead><tr><th>Desafio</th><th>Início (Brasília)</th><th>Objetivos / acertos</th><th>Aproveitamento</th><th>Situação</th><th>Ação</th></tr></thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr><td>@JornadaService.Titulos[t.Desafio - 1]</td><td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(t.IniciadaEm, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById("E. South America Standard Time")).ToString("dd/MM/yyyy HH:mm")</td><td>@t.Pontos / @t.Total</td><td>@t.Aproveitamento%</td><td>@(t.ConcluidaEm == null ? "Em andamento" : t.ArquivadaNaAtualizacao ? "Versão anterior encerrada" : t.Aprovada ? "Concluído" : "Revisar")</td><td><a asp-action="@(t.ConcluidaEm == null ? "Jogar" : "Resultado")" asp-route-id="@t.Id">@(t.ConcluidaEm == null ? "Continuar" : "Revisar")</a></td></tr>
                    }
                </tbody>
            </table></div>
        }
    </section>
    <a class="ec-button" asp-action="Index">Continuar minha jornada →</a>
</div>

