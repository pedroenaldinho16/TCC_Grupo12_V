@model TCC_Grupo12_III.Models.Usuario
@{ViewData["Title"]="Criar conta de estudante";}
<section class="ec-auth"><div class="ec-auth-intro"><span class="ec-eyebrow" style="color:#c4e7d8">Conhecer para preservar</span><h1>Sua jornada começa com uma descoberta.</h1><p>Uma conta gratuita para conhecer os animais, participar dos desafios e acompanhar suas conquistas educativas.</p><img src="~/img/especies/saira-sete-cores.jpg" alt="Saíra-sete-cores" width="440" height="240" /></div><div class="ec-auth-form"><h2>Crie sua conta.</h2><p>Comece a aprender sobre a fauna da Cantareira.</p><form asp-action="Index" method="post"><div asp-validation-summary="ModelOnly" role="alert"></div><div class="ec-field"><label asp-for="Nome">Nome completo</label><input asp-for="Nome" autocomplete="name" required maxlength="100" /><span asp-validation-for="Nome"></span></div><div class="ec-field"><label asp-for="Email">E-mail</label><input asp-for="Email" type="email" autocomplete="email" required /><span asp-validation-for="Email"></span></div><div class="ec-field"><label asp-for="Senha">Senha</label><input asp-for="Senha" type="password" autocomplete="new-password" required minlength="6" aria-describedby="senha-ajuda" /><small id="senha-ajuda">Use pelo menos seis caracteres.</small><span asp-validation-for="Senha"></span></div><button class="ec-button" type="submit">Começar minha jornada →</button></form><p class="ec-form-footer">Já tem uma conta? <a asp-controller="Login" asp-action="Index">Entrar</a></p><a class="ec-breadcrumb" asp-controller="Home" asp-action="Index">← Voltar ao início</a></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial" />}