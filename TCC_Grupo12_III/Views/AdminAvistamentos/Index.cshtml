@model List<TCC_Grupo12_III.Models.Avistamento>
@{ViewData["Title"]="Analisar avistamentos";}
<div class="ec-page"><h1>Analisar avistamentos</h1><partial name="_AdminTabs" /><p>Confira as evidências antes de aprovar um registro. As coordenadas precisas são restritas à administração.</p>@if(Model.Count==0){<p class="ec-empty">Nenhum avistamento enviado.</p>}@foreach(var a in Model){<article class="ec-card mb-3"><h2 style="font-size:1.3rem">@a.NomeAnimal</h2><p>@a.DataAvistamento.ToString("dd/MM/yyyy") · @a.Quantidade indivíduo(s) · @(a.Aprovado?"Aprovado":"Aguardando análise")</p><p>Coordenadas restritas: @a.Latitude, @a.Longitude</p><p>@a.Observacoes</p>@foreach(var m in a.Midias){@if(m.Caminho.StartsWith("/evidencias/")){<a asp-action="Evidencia" asp-route-id="@m.Id">Baixar evidência (@m.Tipo)</a>}else{<a href="@m.Caminho">Consultar evidência original (@m.Tipo)</a>}}<form asp-action="Aprovar" method="post" class="mt-3"><input name="id" type="hidden" value="@a.Id" /><input name="aprovado" type="hidden" value="@(!a.Aprovado)" /><button class="ec-button ec-button-outline" type="submit">@(a.Aprovado?"Retirar do mapa":"Aprovar registro")</button></form></article>}</div>