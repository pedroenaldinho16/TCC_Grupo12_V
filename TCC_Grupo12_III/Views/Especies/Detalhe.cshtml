@model TCC_Grupo12_III.Models.Especie
@{ViewData["Title"]=Model.Nome;var quiz=(List<TCC_Grupo12_III.Models.EspecieQuizPergunta>)ViewBag.Quiz;var logado=User.Identity?.IsAuthenticated==true;}
<div class="ec-page"><a class="ec-breadcrumb" asp-action="Index">← Conheça os animais</a><section class="ec-species-head"><div><span class="ec-eyebrow">@(Model.Categoria=="Aves"?"Aves":"Animais terrestres") · Ficha educativa</span><h1>@Model.Nome</h1><p><em>@Model.NomeCientifico</em></p><p class="ec-lead">@Model.Caracteristicas</p><a class="ec-button ec-button-outline" href="#aprender">Explorar a ficha ↓</a></div>@if(!string.IsNullOrWhiteSpace(Model.ImagemUrl)){<img src="@Model.ImagemUrl" alt="@Model.Nome" width="530" height="360" />}</section><div id="aprender" class="ec-facts">
<section class="ec-card"><h2>Onde vive</h2><p>@Model.Habitat</p></section><section class="ec-card"><h2>Alimentação</h2><p>@Model.Alimentacao</p></section><section class="ec-card"><h2>Características e comportamento</h2><p>@Model.Caracteristicas</p><p>@Model.Comportamento</p></section><section class="ec-card"><h2>Ameaças à espécie</h2><ul>@foreach(var a in Model.Ameacas.Split('\n',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)){<li>@a</li>}</ul></section>
<section class="ec-card"><h2>Importância ecológica</h2><p>@(string.IsNullOrWhiteSpace(Model.ImportanciaEcologica)?"O conteúdo específico sobre o papel ecológico desta espécie está em revisão pela equipe. Consulte o habitat, a alimentação e as ameaças já descritos nesta ficha.":Model.ImportanciaEcologica)</p></section>
<section class="ec-card"><h2>Como contribuir com a preservação</h2><p>@(string.IsNullOrWhiteSpace(Model.AcoesPreservacao)?"Observe a fauna sem capturar, alimentar ou perseguir os animais. Respeite as trilhas autorizadas e leve seus resíduos de volta para descarte adequado.":Model.AcoesPreservacao)</p><a href="https://www.gov.br/icmbio/pt-br/centrais-de-conteudo/guia2-pdf" target="_blank" rel="noopener">Guia de conduta consciente · ICMBio ↗</a></section>
</div>
<section class="ec-card mt-4"><h2>Conservação e referências</h2><p>As avaliações global, brasileira e paulista têm abrangências diferentes. Uma classificação não substitui a outra.</p><dl><dt>Global</dt><dd>@(string.IsNullOrWhiteSpace(Model.ConservacaoGlobal)?"Avaliação e referência pendentes de validação.":Model.ConservacaoGlobal)</dd><dt>Brasil</dt><dd>@(string.IsNullOrWhiteSpace(Model.ConservacaoNacional)?"Avaliação e referência pendentes de validação.":Model.ConservacaoNacional)</dd><dt>São Paulo</dt><dd>@(string.IsNullOrWhiteSpace(Model.ConservacaoRegional)?"Avaliação e referência pendentes de validação.":Model.ConservacaoRegional)</dd><dt>Fontes da ficha</dt><dd>@(string.IsNullOrWhiteSpace(Model.FonteCientifica)?"Conteúdo original do Grupo 12. Referências científicas específicas em revisão.":Model.FonteCientifica)</dd></dl></section>
<section id="quiz" class="ec-section"><h2>Uma pausa para descobrir.</h2><p>Revise os conhecimentos desta ficha no quiz da espécie. A jornada dos três desafios está disponível em Jogos e desafios.</p>
@if(logado&&quiz.Count>0){<form asp-controller="EspecieQuiz" asp-action="Enviar" asp-route-id="@Model.Id" method="post">@for(var i=0;i<quiz.Count;i++){var q=quiz[i];<fieldset class="ec-card mb-3"><legend class="fs-6">@q.Enunciado</legend><input type="hidden" name="respostas[@i].PerguntaId" value="@q.Id" /><div class="ec-options">@for(var j=1;j<=4;j++){<label class="ec-option"><input type="radio" name="respostas[@i].OpcaoSelecionada" value="@j" required /><span>@q.OpcaoTexto(j)</span></label>}</div></fieldset>}<button type="submit" class="ec-button">Conferir respostas →</button></form><form asp-action="MarcarEstudoLido" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id" /><button class="ec-button ec-button-outline" type="submit">Marcar ficha como estudada</button></form>}
else if(!logado){<a class="ec-button" asp-controller="Login" asp-action="Index">Entrar para praticar e salvar progresso</a>}else{<p>As questões desta espécie estão em preparação.</p>}
</section><a class="ec-button" asp-controller="Jornada" asp-action="Index">Continuar minha jornada →</a></div>