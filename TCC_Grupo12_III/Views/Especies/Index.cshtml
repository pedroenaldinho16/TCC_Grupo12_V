@model List<TCC_Grupo12_III.Models.Especie>
@{ViewData["Title"]="Conheça os animais"; var dex=(TCC_Grupo12_III.Models.PokedexViewModel)ViewBag.Pokedex;}
<div class="ec-page"><span class="ec-eyebrow">CantaDex · Fauna da Cantareira</span><h1>Conheça quem vive na floresta.</h1><p class="ec-lead">Cada espécie tem uma história e um papel no ambiente. Explore as fichas e prepare-se para o Detetive da Fauna.</p><form class="ec-search" method="get"><div><label for="busca">Nome popular ou científico</label><input id="busca" name="busca" value="@ViewBag.Busca" type="search" placeholder="Qual animal você quer conhecer?" /></div><div><label for="filtro">Categoria</label><select id="filtro" name="filtro"><option value="Todos" selected="@(ViewBag.Filtro=="Todos")">Todas as espécies</option><option value="Aves" selected="@(ViewBag.Filtro=="Aves")">Aves</option><option value="Terrestres" selected="@(ViewBag.Filtro=="Terrestres")">Animais terrestres</option></select></div><button class="ec-button" type="submit">Buscar</button><a asp-action="Index">Limpar filtros</a></form><p>@Model.Count espécie(s) encontrada(s)</p>
@if(Model.Count==0){<p class="ec-empty">Nenhuma espécie encontrada. Tente outro nome ou remova os filtros.</p>}
<div class="ec-grid">@foreach(var e in Model){<article class="ec-card ec-animal">@if(!string.IsNullOrEmpty(e.ImagemUrl)){<img src="@e.ImagemUrl" alt="@e.Nome" loading="lazy" width="360" height="230" data-fallback />}<div><span class="ec-pill">@(e.Categoria=="Aves"?"Aves":"Animais terrestres")</span><h2 style="font-size:1.2rem;margin:13px 0 5px">@e.Nome</h2><em>@e.NomeCientifico</em>@if(dex.Entradas.Any(x=>x.Especie.Id==e.Id && x.Dominada)){<p class="ec-pill mt-2">Espécie conquistada ✓</p>}<p class="mt-3">@e.Caracteristicas</p><a asp-action="Detalhe" asp-route-id="@e.Id">Conhecer a espécie →</a></div></article>}</div><div class="ec-notice">O catálogo utiliza os registros existentes do projeto. A seleção final de sete aves e sete espécies terrestres está em revisão pela equipe.</div><a class="ec-button" asp-controller="Jornada" asp-action="Index">Praticar no Detetive da Fauna →</a></div>