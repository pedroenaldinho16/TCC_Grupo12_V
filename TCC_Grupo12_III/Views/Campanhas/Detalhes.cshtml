@model TCC_Grupo12_III.Models.Campanha
@using TCC_Grupo12_III.Models
@using System.Security.Claims
@{ViewData["Title"]=Model.Titulo;var mural=(List<ForumTopico>)ViewBag.Mural;var uid=int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier),out var idAtual)?idAtual:0;}
<div class="ec-page"><a class="ec-breadcrumb" asp-action="Index">← Campanhas de preservação</a><span class="ec-eyebrow">@(Model.Ativa?"Campanha ativa":"Campanha encerrada")</span><h1>@Model.Titulo</h1><p class="ec-lead">@Model.Descricao</p><div class="ec-facts ec-section"><section class="ec-card"><h2>Por que participar</h2><p>@Model.ObjetivoPrincipal</p><p>@Model.ObjetivosEspecificos</p><p>@Model.ImpactoEsperado</p></section><section class="ec-card"><h2>Planeje sua participação</h2><p>Período: @Model.Periodo</p><p>Local: @Model.LocalEncontro</p><p>@Model.Horario</p><p>Responsável: @Model.Organizador</p><p>@Model.OQueLevar</p></section></div>@if(Model.Ativa){@if(User.Identity?.IsAuthenticated!=true){<a class="ec-button" asp-controller="Login" asp-action="Index">Entrar para participar</a>}else if(ViewBag.Participando==true){<p class="ec-notice">Sua participação está registrada.</p>}else{<form asp-action="Participar" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="ec-button" type="submit">Quero participar →</button></form>}}
<section id="mural" class="ec-section"><h2>Mural da campanha</h2><p>Compartilhe aprendizados relacionados a esta ação. Respeite as pessoas e não divulgue localizações sensíveis. A administração acompanha as publicações.</p>
@if(uid>0&&Model.Ativa){<form asp-controller="Forum" asp-action="Criar" method="post" class="ec-card mb-4"><input name="campanhaId" value="@Model.Id" type="hidden" /><div class="ec-field"><label for="titulo-mural">Título da reflexão</label><input id="titulo-mural" name="titulo" maxlength="150" required /></div><div class="ec-field"><label for="conteudo-mural">O que você quer compartilhar?</label><textarea id="conteudo-mural" name="conteudo" maxlength="2000" required rows="3"></textarea></div><button type="submit" class="ec-button">Publicar no mural</button></form>}
@if(mural.Count==0){<p class="ec-empty">O mural ainda não tem publicações. Compartilhe a primeira descoberta desta campanha.</p>}
@foreach(var t in mural){<article class="ec-card mb-3"><h3>@t.Titulo</h3><p class="ec-article">@t.Conteudo</p><small>@t.Usuario?.Nome · @t.CriadoEm.ToString("dd/MM/yyyy")</small><p>@t.Curtidas.Count apoio(s)</p>@if(uid>0){<form asp-controller="Forum" asp-action="Curtir" method="post"><input name="id" value="@t.Id" type="hidden" /><button class="ec-button ec-button-outline" type="submit">@(t.Curtidas.Any(c=>c.UsuarioId==uid)?"Retirar apoio":"Apoiar reflexão")</button></form>}@foreach(var r in t.Respostas){<div class="ec-notice"><strong>@r.Usuario?.Nome</strong><p class="mb-0">@r.Conteudo</p></div>}@if(uid>0&&Model.Ativa){<form asp-controller="Forum" asp-action="Responder" method="post"><input name="id" value="@t.Id" type="hidden" /><div class="ec-field"><label for="resposta-@t.Id">Comentar reflexão</label><textarea id="resposta-@t.Id" name="conteudo" required maxlength="2000" rows="2"></textarea></div><button class="ec-button ec-button-outline" type="submit">Comentar</button></form>}</article>}
</section></div>