@model List<TCC_Grupo12_III.Models.ArtigoEducacao>
@{ViewData["Title"]="Voz Estudantil";var meus=(List<TCC_Grupo12_III.Models.EstudoCientifico>)ViewBag.Meus;}
<div class="ec-page"><span class="ec-eyebrow">Aprender também é compartilhar</span><h1>Voz Estudantil</h1><p class="ec-lead">Leituras e reflexões sobre a fauna e sua preservação. Os textos enviados por estudantes passam pela revisão da administração antes da publicação.</p><div class="ec-actions"><a class="ec-button" asp-action="Publicar">Compartilhar meu aprendizado →</a>@if(User.IsInRole("Admin")){<a class="ec-button ec-button-outline" asp-action="Revisar">Revisar publicações</a>}</div><form class="ec-search" method="get"><div><label for="busca">Pesquisar leituras</label><input id="busca" type="search" name="busca" /></div><button class="ec-button ec-button-outline" type="submit">Buscar</button></form><div class="ec-grid">@foreach(var a in Model){<article class="ec-card"><span class="ec-eyebrow">@a.Categoria</span><h2 style="font-size:1.25rem">@a.Titulo</h2><p>@a.Resumo</p><small>@a.Autor</small><a class="mt-3" asp-action="Artigo" asp-route-slug="@a.Slug">Ler conteúdo →</a></article>}</div>@if(meus.Count>0){<section class="ec-section"><h2>Meus textos em análise</h2>@foreach(var e in meus){<div class="ec-card mb-3"><h3>@e.Titulo</h3><p>@e.StatusAprovacao · @e.ObservacoesAdmin</p></div>}</section>}</div>