@model TCC_Grupo12_III.Models.LoginViewModel
@{ViewData["Title"]="Entrar";}
<section class="ec-auth"><div class="ec-auth-intro"><span class="ec-eyebrow" style="color:#c4e7d8">Sua próxima descoberta</span><h1>A Cantareira tem muito a ensinar.</h1><p>Continue sua jornada, conheça as espécies e acompanhe o que você já aprendeu.</p><img src="~/img/especies/bugio-ruivo.jpg" alt="Bugio-ruivo" width="440" height="240" /></div><div class="ec-auth-form"><h2>Bom ter você por aqui.</h2><p>Entre na sua conta EcoCanta.</p><form asp-action="Index" method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /><div asp-validation-summary="ModelOnly" role="alert"></div><div class="ec-field"><label asp-for="Email">E-mail</label><input asp-for="Email" type="email" autocomplete="email" required /><span asp-validation-for="Email"></span></div><div class="ec-field"><label asp-for="Senha">Senha</label><input asp-for="Senha" type="password" autocomplete="current-password" required /><span asp-validation-for="Senha"></span></div><button class="ec-button" type="submit">Entrar →</button></form><p class="ec-form-footer">Ainda não tem conta? <a asp-controller="Cadastro" asp-action="Index">Cadastre-se</a></p><a class="ec-breadcrumb" asp-controller="Home" asp-action="Index">← Voltar ao início</a></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial" />}