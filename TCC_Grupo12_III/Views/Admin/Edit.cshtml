@model TCC_Grupo12_III.Models.AdminUsuarioViewModel
@{ViewData["Title"]="Editar conta";}
<div class="ec-page"><h1>Editar conta</h1><partial name="_AdminTabs" /><form method="post" class="ec-card" style="max-width:620px"><div asp-validation-summary="All" role="alert"></div><input asp-for="Id" type="hidden" /><div class="ec-field"><label asp-for="Nome">Nome</label><input asp-for="Nome" required /></div><div class="ec-field"><label asp-for="Email">E-mail</label><input asp-for="Email" type="email" required /></div><div class="ec-field"><label asp-for="NovaSenha">Nova senha (opcional)</label><input asp-for="NovaSenha" type="password" autocomplete="new-password" /></div><div class="ec-field"><label asp-for="Xp">Pontos de experiência</label><input asp-for="Xp" type="number" min="0" /><small>XP não libera desafios nem o mapa.</small></div><label class="ec-option"><input asp-for="IsAdmin" /><span>Administrador autorizado</span></label><label class="ec-option mt-3"><input asp-for="IsBanido" /><span>Bloquear acesso desta conta</span></label><button class="ec-button mt-4" type="submit">Salvar alterações</button></form></div>