@model TCC_Grupo12_III.Models.Usuario
@{ViewData["Title"]="Cadastrar conta";}
<div class="ec-page"><h1>Cadastrar conta</h1><partial name="_AdminTabs" /><form method="post" class="ec-card" style="max-width:620px"><div asp-validation-summary="All" role="alert"></div><div class="ec-field"><label asp-for="Nome">Nome</label><input asp-for="Nome" required /></div><div class="ec-field"><label asp-for="Email">E-mail</label><input asp-for="Email" type="email" required /></div><div class="ec-field"><label asp-for="Senha">Senha inicial</label><input asp-for="Senha" type="password" autocomplete="new-password" required minlength="6" /></div><label class="ec-option"><input asp-for="IsAdmin" /><span>Administrador autorizado pela equipe</span></label><p class="mt-3">Sem esta permissão, a conta será de Estudante.</p><button class="ec-button" type="submit">Criar conta</button></form></div>