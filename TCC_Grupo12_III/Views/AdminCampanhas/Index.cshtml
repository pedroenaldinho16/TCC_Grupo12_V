@model List<TCC_Grupo12_III.Models.Campanha>
@{ViewData["Title"]="Gerenciar campanhas";}
<div class="ec-page"><h1>Gerenciar campanhas</h1><partial name="_AdminTabs" /><p>Organize as ações de preservação e atualize suas orientações.</p><div class="ec-actions"><a class="ec-button" asp-action="Create">Cadastrar campanha</a><a asp-action="Index" asp-route-aba="ativas">Ativas</a><a asp-action="Index" asp-route-aba="encerradas">Encerradas</a></div><div class="ec-history mt-4"><table><thead><tr><th>Campanha</th><th>Período</th><th>Situação</th><th>Ações</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Titulo</td><td>@c.Periodo</td><td>@(c.Ativa?"Ativa":"Encerrada")</td><td><a asp-action="Edit" asp-route-id="@c.Id">Editar</a> · <a asp-controller="Campanhas" asp-action="Detalhes" asp-route-id="@c.Id">Ver campanha</a></td></tr>}</tbody></table></div></div>