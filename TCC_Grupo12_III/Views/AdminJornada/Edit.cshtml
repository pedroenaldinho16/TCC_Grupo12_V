@model TCC_Grupo12_III.Models.JornadaPergunta
@using TCC_Grupo12_III.Services
@{ViewData["Title"]="Editar questão";}
<div class="ec-page"><h1>Editar questão educativa</h1><partial name="_AdminTabs" /><form method="post" class="ec-card"><div asp-validation-summary="All" role="alert"></div><input asp-for="Id" type="hidden" /><div class="ec-field"><label asp-for="Desafio">Desafio</label><select asp-for="Desafio" class="form-select"><option value="2">Guardião da Cantareira · Quiz</option></select></div><div class="ec-field"><label asp-for="Enunciado">Situação ou pista</label><textarea asp-for="Enunciado" required rows="3"></textarea></div><div class="ec-grid ec-grid-two"><div class="ec-field"><label asp-for="OpcaoA">Alternativa A</label><input asp-for="OpcaoA" required /></div><div class="ec-field"><label asp-for="OpcaoB">Alternativa B</label><input asp-for="OpcaoB" required /></div><div class="ec-field"><label asp-for="OpcaoC">Alternativa C</label><input asp-for="OpcaoC" required /></div><div class="ec-field"><label asp-for="OpcaoD">Alternativa D</label><input asp-for="OpcaoD" required /></div></div><div class="ec-field"><label asp-for="Correta">Alternativa esperada</label><select asp-for="Correta" class="form-select"><option value="1">A</option><option value="2">B</option><option value="3">C</option><option value="4">D</option></select></div><div class="ec-field"><label asp-for="Explicacao">Explicação educativa</label><textarea asp-for="Explicacao" rows="4" required></textarea></div><div class="ec-field"><label asp-for="Fonte">Referência ou fonte</label><textarea asp-for="Fonte" rows="2" required></textarea></div><div class="ec-field"><label asp-for="ImagemUrl">Imagem local (opcional)</label><input asp-for="ImagemUrl" placeholder="/img/especies/..." /></div><label class="ec-option"><input asp-for="Ativa" /><span>Disponível para novas tentativas</span></label><button class="ec-button mt-4" type="submit">Salvar questão</button></form></div>