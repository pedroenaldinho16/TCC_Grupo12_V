@model List<TCC_Grupo12_III.Models.FaqTicket>
@{ViewData["Title"]="Atendimento aos estudantes";}
<div class="ec-page"><h1>Atendimento aos estudantes</h1><partial name="_AdminTabs" /><p>Responda às dúvidas e acompanhe os chamados da plataforma.</p><div class="ec-history"><table><thead><tr><th>Assunto</th><th>Estudante</th><th>Situação</th><th>Ação</th></tr></thead><tbody>@foreach(var t in Model){<tr><td>@t.Assunto</td><td>@t.Usuario?.Nome</td><td>@t.Status</td><td><a asp-action="Atender" asp-route-id="@t.Id">Atender</a></td></tr>}</tbody></table></div></div>