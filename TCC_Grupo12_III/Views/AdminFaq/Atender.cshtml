@model TCC_Grupo12_III.Models.FaqTicket
@{ViewData["Title"]="Responder dúvida";}
<div class="ec-page" style="max-width:900px"><h1>@Model.Assunto</h1><partial name="_AdminTabs" /><p>@Model.Usuario?.Nome · @Model.Status</p>@foreach(var m in Model.Mensagens.OrderBy(m=>m.CriadoEm)){<article class="ec-card mb-3"><strong>@m.Usuario?.Nome · @(m.IsEquipeModOuAdmin?"Administração":"Estudante")</strong><p class="ec-article">@m.Conteudo</p></article>}<form method="post" asp-action="Responder" class="ec-card"><input name="ticketId" value="@Model.Id" type="hidden" /><div class="ec-field"><label for="conteudo">Resposta da equipe</label><textarea id="conteudo" name="conteudo" rows="5" maxlength="2000" required></textarea></div><div class="ec-field"><label for="status">Situação após resposta</label><select id="status" name="novoStatus" class="form-select"><option>Respondido</option><option>Fechado</option></select></div><button class="ec-button" type="submit">Enviar resposta</button></form></div>