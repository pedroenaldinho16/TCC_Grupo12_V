@model TCC_Grupo12_III.Models.AvistamentoRegistroViewModel
@{ViewData["Title"]="Registrar avistamento";}
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
<div class="ec-page"><a class="ec-breadcrumb" asp-action="Index">← Voltar ao mapa</a><h1>Um registro, uma nova descoberta.</h1><p class="ec-lead">Compartilhe uma observação responsável. Todos os registros passam por análise antes de aparecer no mapa.</p><form method="post" enctype="multipart/form-data" class="ec-card"><div asp-validation-summary="All" role="alert"></div><div class="ec-grid ec-grid-two"><div class="ec-field"><label asp-for="Form.EspecieId">Espécie</label><select asp-for="Form.EspecieId" class="form-select" required><option value="">Selecione</option>@foreach(var e in Model.EspeciesPokedex){<option value="@e.Id">@e.Nome</option>}</select></div><div class="ec-field"><label asp-for="Form.DataAvistamento">Data da observação</label><input asp-for="Form.DataAvistamento" type="date" required /></div><div class="ec-field"><label asp-for="Form.Quantidade">Quantidade de indivíduos</label><input asp-for="Form.Quantidade" type="number" min="1" max="500" /></div><div class="ec-field"><label asp-for="Form.NomeObservador">Observador</label><input asp-for="Form.NomeObservador" readonly /></div></div><p>Marque o local no mapa ou informe as coordenadas. A posição precisa será visível apenas à administração.</p><div id="mapa-registro" class="ec-map"></div><div class="ec-grid ec-grid-two"><div class="ec-field"><label asp-for="Form.Latitude">Latitude</label><input asp-for="Form.Latitude" inputmode="decimal" placeholder="-23.41" required /></div><div class="ec-field"><label asp-for="Form.Longitude">Longitude</label><input asp-for="Form.Longitude" inputmode="decimal" placeholder="-46.61" required /></div></div><div class="ec-field"><label asp-for="Form.Fotos">Fotografias (JPG, PNG ou WebP, até 10 MB cada)</label><input asp-for="Form.Fotos" type="file" multiple accept="image/jpeg,image/png,image/webp" /></div><div class="ec-field"><label asp-for="Form.Videos">Vídeos (MP4, WebM ou OGV, até 60 MB cada)</label><input asp-for="Form.Videos" type="file" multiple accept="video/mp4,video/webm,video/ogg" /><small>Máximo de cinco arquivos no total. As evidências serão consultadas somente pela administração.</small></div><div class="ec-field"><label asp-for="Form.Observacoes">O que você observou?</label><textarea asp-for="Form.Observacoes" rows="4" maxlength="500"></textarea></div><button class="ec-button" type="submit">Enviar para análise →</button></form></div>
@section Scripts{<script src="~/lib/leaflet/leaflet.js"></script><script>
if(window.L){const map=L.map('mapa-registro').setView([-23.411,-46.616],12);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'© OpenStreetMap contributors'}).addTo(map);let mark;map.on('click',e=>{if(mark)mark.remove();mark=L.marker(e.latlng).addTo(map);document.getElementById('Form_Latitude').value=e.latlng.lat.toFixed(6);document.getElementById('Form_Longitude').value=e.latlng.lng.toFixed(6);});}
</script>}