@model TCC_Grupo12_III.Models.AvistamentoMapaViewModel
@using System.Text.Json
@{ViewData["Title"]="Mapa de avistamentos";}
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
<div class="ec-page"><span class="ec-eyebrow">Jornada concluída · Observe com responsabilidade</span><h1>Novos olhares para a Cantareira.</h1><p class="ec-lead">Explore registros aprovados de fauna. As posições exibidas aos estudantes representam regiões aproximadas para proteger os animais.</p><div class="ec-search"><div><label for="especie-mapa">Filtrar registros</label><select id="especie-mapa"><option value="">Todas as espécies</option>@foreach(var e in Model.Especies){<option value="@e.Id">@e.Nome</option>}</select></div><a class="ec-button" asp-action="Registrar">Registrar avistamento →</a></div><div id="mapa" class="ec-map" role="region" aria-label="Mapa com regiões aproximadas de avistamentos"></div><p id="mapa-status" role="status"></p><noscript><p>O mapa precisa de JavaScript. Os registros também estão disponíveis na lista abaixo.</p></noscript><h2 class="mt-5">Registros aprovados</h2>@if(Model.Avistamentos.Count==0){<p class="ec-empty">Ainda não há registros aprovados para exibir. Você pode enviar um avistamento para análise.</p>}<div class="ec-grid">@foreach(var a in Model.Avistamentos){<article class="ec-card" data-especie="@a.EspecieId"><h3>@a.NomeAnimal</h3><p>@a.DataAvistamento.ToString("dd/MM/yyyy") · @a.Quantidade indivíduo(s)<br />Localização aproximada na Serra da Cantareira.</p></article>}</div><div class="ec-notice">Não capture nem se aproxime dos animais para obter um registro. Não publique coordenadas de ninhos, abrigos ou locais sensíveis.</div></div>
@section Scripts{
<script src="~/lib/leaflet/leaflet.js"></script>
<script>
(() => {
 const items=@Html.Raw(JsonSerializer.Serialize(Model.Avistamentos.Select(a=>new{especie=a.EspecieId,nome=a.NomeAnimal,lat=a.Latitude,lon=a.Longitude})));
 const status=document.getElementById('mapa-status');
 if(!window.L){status.textContent='Não foi possível carregar o mapa. Consulte os registros abaixo.';return;}
 const map=L.map('mapa').setView([-23.411,-46.616],12);
 const layer=L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:15,attribution:'© OpenStreetMap contributors'}).addTo(map);
 layer.on('tileerror',()=>status.textContent='O mapa de fundo está indisponível. A lista de registros continua acessível.');
 const markers=L.layerGroup().addTo(map);
 function render(){const v=document.getElementById('especie-mapa').value;markers.clearLayers();items.filter(a=>!v||String(a.especie)===v).forEach(a=>{const text=document.createElement('span');text.textContent=a.nome+' · região aproximada';L.circle([a.lat,a.lon],{radius:1300,color:'#2b8171',fillOpacity:.12}).bindPopup(text).addTo(markers);});document.querySelectorAll('[data-especie]').forEach(el=>el.hidden=!!v&&el.dataset.especie!==v);}
 document.getElementById('especie-mapa').addEventListener('change',render);render();
})();
</script>}